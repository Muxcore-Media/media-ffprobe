[Unit]
Description=MuxCore Module - media-ffprobe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/media-ffprobe \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id media-ffprobe
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
; Library paths often live under /home or /mnt — add them via ReadOnlyPaths= instead of ProtectHome.
ReadWritePaths=/var/lib/media-ffprobe
; Example: ReadOnlyPaths=/mnt/media /home/muxcore/media

[Install]
WantedBy=multi-user.target
